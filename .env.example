# ─────────────────────────────────────────────────────────────
#  Sinan & Şule — ortam değişkenleri
#  Vercel: Project → Settings → Environment Variables
#  Yerel: bu dosyayı .env.local olarak kopyalayıp doldurun.
# ─────────────────────────────────────────────────────────────

# Google Apps Script web uygulamasının /exec adresi (README → 3. adım)
APPS_SCRIPT_URL=

# Apps Script'teki API_SECRET ile birebir aynı uzun rastgele değer
APPS_SCRIPT_SECRET=

# /admin sayfasının şifresi (en az 6 karakter; kodda hiçbir yerde durmaz)
ADMIN_PASSWORD=

# İsteğe bağlı: admin panelinde "Google Sheet'i aç" bağlantısı
SHEET_URL=

# İsteğe bağlı: sitenin tam adresi. Boş bırakılırsa Vercel üretim adresi kullanılır.
NEXT_PUBLIC_SITE_URL=

# İsteğe bağlı: admin oturum imzası için ek gizli değer
SESSION_SECRET=
